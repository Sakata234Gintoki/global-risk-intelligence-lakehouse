# ---- Lakehouse storage -------------------------------------------------------
# Local dev: a folder.  Production: s3://<bucket>/<prefix>
GRIL_STORAGE_ROOT=/opt/airflow/data
# local | databricks
GRIL_EXECUTION_MODE=local
GRIL_ENABLE_SNOWFLAKE=false

# ---- AWS (only when GRIL_STORAGE_ROOT is s3://...) ---------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# ---- Snowflake ---------------------------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=GRIL_TRANSFORMER
SNOWFLAKE_WAREHOUSE=GRIL_WH
SNOWFLAKE_DATABASE=GRIL
DBT_TARGET=dev

# ---- Databricks (GRIL_EXECUTION_MODE=databricks) ------------------------------
AIRFLOW_CONN_DATABRICKS_DEFAULT=databricks://:<token>@<workspace-host>
GRIL_DATABRICKS_CLUSTER_ID=
GRIL_WHEEL_PATH=dbfs:/FileStore/wheels/gril-1.0.0-py3-none-any.whl
